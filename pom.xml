            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-engine-contract-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-datasource-connection</artifactId>
