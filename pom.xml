<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.baize.flow</groupId>
    <artifactId>yak-ops</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Yak Ops</name>
    <properties>
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-assembly-plugin.version>3.3.0</maven-assembly-plugin.version>
        <maven-release-plugin.version>2.5.3</maven-release-plugin.version>
        <maven-javadoc-plugin.version>2.10.3</maven-javadoc-plugin.version>
        <maven-source-plugin.version>2.4</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.0.0-M6</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.1.1</maven-dependency-plugin.version>
        <maven-shade-plugin.version>3.2.1</maven-shade-plugin.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <file_encoding>UTF-8</file_encoding>
    </properties>
    <!--
      Module migration matrix (old -> owner):
      yak-ops-core          -> yak-ops-domain + yak-ops-application + yak-ops-infrastructure (never recreate)
      yak-ops-api           -> yak-ops-web + yak-ops-web-contract (never recreate; application contracts are not HTTP APIs)
      yak-ops-engine-client -> yak-ops-engine-contract + yak-ops-engine-support + vendor adapters (never recreate)
      yak-ops-engine-spi    -> yak-ops-engine-contract
      yak-ops-engine-runtime-> yak-ops-engine-support
      yak-ops-spi           -> yak-ops-plugin-spi (compatibility facade removed)
      yak-ops-application-support -> application logic in yak-ops-application; vendor/config adapters in adapters
    -->
    <modules>
        <module>yak-ops-domain</module>
        <module>yak-ops-application</module>
        <module>yak-ops-infrastructure</module>
        <module>yak-ops-web</module>
        <module>yak-ops-boot</module>
        <module>yak-ops-common</module>
        <module>yak-ops-datasource-connection</module>
        <module>yak-ops-datasource-plugins</module>
        <module>yak-ops-alarm-plugins</module>
        <module>yak-ops-ui</module>
        <module>yak-ops-dao</module>
        <module>yak-ops-persistence-plugins</module>
        <module>yak-ops-bom</module>
        <module>yak-ops-plugin-spi</module>
        <module>yak-ops-web-contract</module>
        <module>yak-ops-engine-support</module>
        <module>yak-ops-engine-contract</module>
        <module>yak-ops-engine-contract-testkit</module>
        <module>yak-ops-engine-legacy</module>
        <module>yak-ops-engine-all</module>
        <module>yak-ops-dist</module>
    </modules>
