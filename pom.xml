                <artifactId>yak-ops-alarm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-alarm-vendor-webhook</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-alarm-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-alarm-all</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yak.ops</groupId>
                <artifactId>yak-ops-datasource-support</artifactId>
                <version>${project.version}</version>
